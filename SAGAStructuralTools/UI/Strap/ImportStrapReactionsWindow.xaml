<Window x:Class="SAGAStructuralTools.UI.Strap.ImportStrapReactionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SAGA — Importar Reações STRAP" Width="1420" Height="780" MinWidth="1000" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="#F8F9FB" FontFamily="Segoe UI" FontSize="12">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{Binding FilePath, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <TextBlock Margin="0,4,0,0" Foreground="#5E6C84"><Run Text="Unidades: força "/><Run Text="{Binding ForceUnit, Mode=OneWay}"/><Run Text="; momento "/><Run Text="{Binding MomentUnit, Mode=OneWay}"/></TextBlock>
   <TextBlock Text="{Binding UnitNotice, Mode=OneWay}" Foreground="#7B4400" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#FFF4E5" BorderBrush="#FFAB00" BorderThickness="1">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasGlobalErrors, Mode=OneWay}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <ItemsControl ItemsSource="{Binding GlobalErrors, Mode=OneWay}"/>
  </Border>
  <Grid Grid.Row="2" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="Selecionar pendentes" Command="{Binding SelectPendingCommand}" Padding="12,6"/>
   <Button Grid.Column="1" Content="Desmarcar todas" Command="{Binding DeselectAllCommand}" Margin="8,0,0,0" Padding="12,6"/>
   <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" ToolTip="Buscar por NO_PILAR"/>
   <StackPanel Grid.Column="5" Orientation="Horizontal"><TextBlock Text="Filtros: " VerticalAlignment="Center"/><Button Content="Todas" Command="{Binding ShowAllCommand}" Padding="10,5"/><Button Content="Válidas" Command="{Binding ShowValidCommand}" Padding="10,5" Margin="4,0"/><Button Content="Com erro" Command="{Binding ShowErrorsCommand}" Padding="10,5"/></StackPanel>
  </Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <DataGrid ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding IsAlreadyUpdated}" Value="True"><Setter Property="Background" Value="#EAF7EE"/></DataTrigger><DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Background" Value="#FFF8E1"/></DataTrigger><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Background" Value="#FDECEC"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Atualizar"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="NO_PILAR" Binding="{Binding NodeId, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="ElementId" Binding="{Binding ElementId, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Linha" Binding="{Binding SourceLine, Mode=OneWay}" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="Rotação 90°"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Rotate90}" IsEnabled="{Binding IsValid}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Novo X1" Binding="{Binding X1, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X2" Binding="{Binding X2, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X3_MAX" Binding="{Binding X3Max, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X3_MIN" Binding="{Binding X3Min, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X4" Binding="{Binding X4, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X5" Binding="{Binding X5, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="Novo X6" Binding="{Binding X6, Mode=OneWay}" IsReadOnly="True"/>
     <DataGridTextColumn Header="Classificação" Binding="{Binding Classification, Mode=OneWay}" Width="*" MinWidth="130" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="2" BorderBrush="#D9DEE8" BorderThickness="1" Background="White" Padding="12"><StackPanel><TextBlock Text="Detalhes por parâmetro" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding SelectedRow.NodeId, StringFormat=NO_PILAR: {0}}" Margin="0,5,0,10"/><ItemsControl ItemsSource="{Binding SelectedRow.ParameterDetails}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Display}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel VerticalAlignment="Center"><TextBlock Text="{Binding FoundCount, StringFormat=Encontradas: {0}}"/><TextBlock Text="{Binding VisibleCount, StringFormat= | Visíveis: {0}}"/><TextBlock Text="{Binding ValidCount, StringFormat= | Válidas: {0}}"/><TextBlock Text="{Binding PendingCount, StringFormat= | Pendentes: {0}}"/><TextBlock Text="{Binding AlreadyUpdatedCount, StringFormat= | Já atualizadas: {0}}"/><TextBlock Text="{Binding SelectedForUpdateCount, StringFormat= | Selecionadas: {0}}" FontWeight="SemiBold" Foreground="#0052CC"/><TextBlock Text="{Binding InvalidCount, StringFormat= | Inválidas: {0}}"/><TextBlock Text="{Binding DeselectedValidCount, StringFormat= | Válidas desmarcadas: {0}}"/></WrapPanel>
   <Button Grid.Column="1" Content="Cancelar" IsCancel="True" Padding="16,7"/><Button Grid.Column="3" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" Click="Import_Click" Padding="16,7" Background="#0052CC" Foreground="White"/>
  </Grid>
 </Grid>
</Window>
