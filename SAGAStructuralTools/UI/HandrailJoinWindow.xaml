<Window x:Class="SAGAStructuralTools.UI.HandrailJoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Unir corrimãos"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="pt-BR"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SAGA - Unir corrimãos"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>
            <TextBlock Text="Os trechos serão ajustados até os pontos de tangência e unidos por um ou dois arcos."
                       Margin="0,5,0,0"
                       Foreground="#5E6C84"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,14"
                Background="White"
                BorderBrush="#DFE1E6"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Trechos selecionados"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold"
                           Foreground="#344563"/>
                <TextBlock x:Name="TransitionText"
                           Margin="0,0,0,8"
                           Foreground="#0052CC"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="FirstProfileText"
                           Foreground="#42526E"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SecondProfileText"
                           Margin="0,4,0,0"
                           Foreground="#42526E"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ThirdProfileText"
                           Margin="0,4,0,0"
                           Foreground="#42526E"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Raio no eixo do corrimão"
                           FontWeight="SemiBold"
                           Foreground="#344563"/>
                <TextBlock Text="O mesmo valor será reutilizado nas próximas uniões enquanto o comando permanecer ativo."
                           Margin="0,3,14,0"
                           FontSize="11"
                           Foreground="#6B778C"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Height="36"
                    Background="White"
                    BorderBrush="#BFC2C9"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="mm"
                               Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#6B778C"/>
                    <TextBox x:Name="RadiusTextBox"
                             Margin="9,0,4,0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"/>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock x:Name="ValidationText"
                       MinHeight="18"
                       Foreground="#B42318"
                       FontSize="11"
                       TextWrapping="Wrap"/>
            <Border x:Name="SagaEditWarning"
                    Visibility="Collapsed"
                    Margin="0,6,0,0"
                    Padding="10"
                    Background="#FFF7D6"
                    BorderBrush="#E2B203"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Foreground="#7A5D00"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Esta união é um acabamento manual. Ao editar novamente um dos guarda-corpos SAGA envolvidos, o plugin restaurará os trechos retos e removerá os arcos com segurança."/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar união"
                    Width="112"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Unir e continuar"
                    Width="130"
                    Height="34"
                    IsDefault="True"
                    Click="Apply_Click"
                    Background="#0052CC"
                    Foreground="White"
                    BorderBrush="#0052CC"/>
        </StackPanel>
    </Grid>
</Window>
