<Window x:Class="SAGAStructuralTools.UI.MoveToCoordinateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Mover para coordenada"
        Width="455"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="pt-BR"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Mover para coordenada"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>
            <TextBlock x:Name="ElementText"
                       Margin="0,5,0,0"
                       Foreground="#5E6C84"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Coordenadas exibidas em"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"
                       Foreground="#344563"/>
            <ComboBox x:Name="CoordinateSystemComboBox"
                      Height="34"
                      Padding="7,4"
                      SelectionChanged="CoordinateSystem_SelectionChanged">
                <ComboBoxItem Content="Interno do Revit" Tag="Internal"/>
                <ComboBoxItem Content="Compartilhado (levantamento)" Tag="Shared"/>
            </ComboBox>
            <TextBlock Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="#6B778C"
                       TextWrapping="Wrap"
                       Text="Esta opção apenas interpreta e exibe os valores; nenhuma configuração do projeto será alterada."/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="12"
                Background="White"
                BorderBrush="#DFE1E6"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                           Text="Coordenada atual do ponto de referência"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"
                           Foreground="#344563"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="X"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentXText" Grid.Row="1" Grid.Column="2"
                           VerticalAlignment="Center" Foreground="#42526E"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Y"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentYText" Grid.Row="2" Grid.Column="2"
                           VerticalAlignment="Center" Foreground="#42526E"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Z"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentZText" Grid.Row="3" Grid.Column="2"
                           VerticalAlignment="Center" Foreground="#42526E"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                           Text="Coordenada de destino"
                           Margin="0,12,0,5"
                           FontWeight="SemiBold"
                           Foreground="#344563"/>

                <CheckBox x:Name="UseXCheckBox" Grid.Row="5" Grid.Column="0"
                          IsChecked="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="X"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="XTextBox" Grid.Row="5" Grid.Column="2"
                         Margin="0,3" Padding="7,4"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>

                <CheckBox x:Name="UseYCheckBox" Grid.Row="6" Grid.Column="0"
                          IsChecked="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Y"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="YTextBox" Grid.Row="6" Grid.Column="2"
                         Margin="0,3" Padding="7,4"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>

                <CheckBox x:Name="UseZCheckBox" Grid.Row="7" Grid.Column="0"
                          IsChecked="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="Z"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="ZTextBox" Grid.Row="7" Grid.Column="2"
                         Margin="0,3" Padding="7,4"
                         VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="7" Grid.Column="3" Text="mm"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#6B778C"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="3"
                   MinHeight="18"
                   Margin="0,8,0,0"
                   Foreground="#B42318"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="92" Height="34"
                    Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Mover" Width="92" Height="34"
                    IsDefault="True" Click="Move_Click"
                    Background="#0052CC" Foreground="White"
                    BorderBrush="#0052CC"/>
        </StackPanel>
    </Grid>
</Window>
