<Window x:Class="SAGAStructuralTools.UI.SaveRailPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Salvar padrão"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F8F9FB" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Salvar padrão de guarda-corpo"
                   FontSize="18" FontWeight="SemiBold" Foreground="#172B4D"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14"
                   Text="Informe um nome para reutilizar esta configuração em qualquer projeto."
                   Foreground="#5E6C84" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Nome do padrão" Margin="0,0,0,5"
                       FontWeight="SemiBold" Foreground="#344563"/>
            <TextBox x:Name="PresetNameTextBox" Height="34" Padding="8,5"/>
            <TextBlock x:Name="ValidationText" Margin="0,5,0,0"
                       Foreground="#B42318" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="34"
                    Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Salvar padrão" Width="110" Height="34"
                    IsDefault="True" Click="Save_Click"
                    Background="#0052CC" Foreground="White" BorderBrush="#0052CC"/>
        </StackPanel>
    </Grid>
</Window>
