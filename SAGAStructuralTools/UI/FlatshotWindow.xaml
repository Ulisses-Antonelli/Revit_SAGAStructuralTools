<Window x:Class="SAGAStructuralTools.UI.FlatshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Registro (Flatshot)"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F8F9FB" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Congelar vista como registro"
                   FontSize="18" FontWeight="SemiBold" Foreground="#172B4D"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14"
                   Text="Cria uma Vista de Desenho nova com a geometria e as cotas desta vista congeladas — mudanças futuras no modelo não afetam mais este registro."
                   Foreground="#5E6C84" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Nome da vista de registro" Margin="0,0,0,5"
                       FontWeight="SemiBold" Foreground="#344563"/>
            <TextBox x:Name="ViewNameTextBox" Height="34" Padding="8,5"/>
            <TextBlock x:Name="ValidationText" Margin="0,5,0,0"
                       Foreground="#B42318" FontSize="11"/>
        </StackPanel>
        <CheckBox x:Name="OpenAfterCreateCheckBox" Grid.Row="3" Margin="0,14,0,0"
                  Content="Abrir a vista de registro depois de criar" IsChecked="True"/>
        <StackPanel Grid.Row="4" Margin="0,18,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="34"
                    Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Criar registro" Width="120" Height="34"
                    IsDefault="True" Click="Create_Click"
                    Background="#0052CC" Foreground="White" BorderBrush="#0052CC"/>
        </StackPanel>
    </Grid>
</Window>
