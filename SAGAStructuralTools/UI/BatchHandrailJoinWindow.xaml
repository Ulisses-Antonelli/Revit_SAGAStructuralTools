<Window x:Class="SAGAStructuralTools.UI.BatchHandrailJoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Unir corrimãos em lote"
        Width="720" Height="560" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="pt-BR" Background="#F8F9FB"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SAGA - Configurar uniões de corrimãos"
                       FontSize="18" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock Text="A altura é aplicada somente a pares com dois inclinados; o deslocamento, somente a pares com trecho horizontal. As demais cotas são preservadas."
                       Margin="0,5,0,0" Foreground="#5E6C84"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,12"
                Background="White" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Raio comum" FontWeight="SemiBold"
                           Foreground="#344563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="RadiusTextBox" Grid.Column="1" Height="32" Padding="8,5"/>
                <TextBlock Grid.Column="3" Text="Deslocamento comum" FontWeight="SemiBold"
                           Foreground="#344563" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="OffsetTextBox" Grid.Column="4" Height="32" Padding="8,5"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DFE1E6"
                BorderThickness="1" CornerRadius="5" Padding="1">
            <DataGrid x:Name="PairsGrid" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      BorderThickness="0" AlternatingRowBackground="#F8F9FB">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Par" Binding="{Binding Number}" Width="52" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Corrimãos selecionados" Binding="{Binding Description}"
                                        Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Altura (mm)" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsHeightEditable}"
                                         Padding="4,2"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ToolTip="Editável somente quando os dois trechos do par são inclinados."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Validação" Binding="{Binding Error}" Width="180" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SameHeightCheckBox" Grid.Column="0"
                      Content="Mesma altura para todos" VerticalAlignment="Center"
                      Checked="SameHeight_Checked" Unchecked="SameHeight_Unchecked"/>
            <TextBox x:Name="CommonHeightTextBox" Grid.Column="1" Height="32"
                     Margin="10,0,0,0" Padding="8,5" IsEnabled="False"/>
            <Button x:Name="ApplyHeightButton" Grid.Column="2" Content="Aplicar"
                    Width="72" Height="32" Margin="8,0,0,0" IsEnabled="False"
                    Click="ApplyHeight_Click"/>
            <TextBlock Grid.Column="3" Text="mm" Margin="8,0,0,0"
                       Foreground="#6B778C" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="#B42318" FontSize="11"
                       TextWrapping="Wrap" MinHeight="18"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancelar" Width="96" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Validar e criar lote" Width="155" Height="34" IsDefault="True"
                        Click="Apply_Click" Background="#0052CC" Foreground="White" BorderBrush="#0052CC"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
