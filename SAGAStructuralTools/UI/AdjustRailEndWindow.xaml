<Window x:Class="SAGAStructuralTools.UI.AdjustRailEndWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA - Ajustar extremidade" Height="190" Width="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Deslocamento da extremidade (mm)" FontWeight="SemiBold"/>
        <TextBox x:Name="ValueTextBox" Grid.Row="1" Margin="0,8,0,6" Height="28"
                 VerticalContentAlignment="Center" Text="0" GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"/>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="#555"
                   Text="Valor positivo aumenta o trecho. Valor negativo recua a extremidade selecionada."/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="86" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Aplicar" Width="86" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
