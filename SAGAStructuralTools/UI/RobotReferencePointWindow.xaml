<Window x:Class="SAGAStructuralTools.UI.RobotReferencePointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA — Ponto de Referência do Robot"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Pra não posicionar o modelo nas coordenadas absolutas do Robot (sem relação com o Revit), escolha um nó do arquivo cuja posição você reconhece no modelo do Revit — o próximo passo pede pra clicar o ponto correspondente."/>

        <TextBlock Grid.Row="1" Text="Nó de referência (obrigatório):" Margin="0,0,0,4"/>
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AnchorNodeBox" Grid.Column="0" Padding="4,3" TextChanged="OnNodeIdChanged"/>
            <TextBlock x:Name="AnchorEcho" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
        </Grid>

        <TextBlock Grid.Row="3" Text="Nó de direção (opcional — define a rotação em torno de Z):" Margin="0,16,0,4"/>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DirectionNodeBox" Grid.Column="0" Padding="4,3" TextChanged="OnNodeIdChanged"/>
            <TextBlock x:Name="DirectionEcho" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ContinueButton" Content="Continuar →" Width="120" Style="{StaticResource ActionButton}" IsEnabled="False" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
