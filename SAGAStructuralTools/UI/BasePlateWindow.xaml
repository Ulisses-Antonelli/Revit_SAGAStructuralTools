<Window x:Class="SAGAStructuralTools.UI.BasePlateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dimensionamento de Placa de Base"
        Width="760"
        Height="640"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="pt-BR"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Dimensionamento de Placa de Base"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>
            <TextBlock Margin="0,5,0,0"
                       Text="Verificações iniciais de geometria e chumbadores"
                       Foreground="#5E6C84"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <GroupBox Header="Perfil" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Altura d (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="DepthTextBox" Text="300"/>
                            <TextBlock Text="Mesa bf (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="FlangeWidthTextBox" Text="150"/>
                            <TextBlock Text="Alma tw (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="WebThicknessTextBox" Text="6,3"/>
                            <TextBlock Text="Mesa tf (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="FlangeThicknessTextBox" Text="9,5"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Esforços" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Normal N (tf)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AxialForceTextBox" Text="20"/>
                            <TextBlock Text="Momento Mx (tf.m)" VerticalAlignment="Center"/>
                            <TextBox x:Name="MomentXTextBox" Text="1,5"/>
                            <TextBlock Text="Momento My (tf.m)" VerticalAlignment="Center"/>
                            <TextBox x:Name="MomentYTextBox" Text="0,8"/>
                            <TextBlock Text="Cortante Vx (tf)" VerticalAlignment="Center"/>
                            <TextBox x:Name="ShearXTextBox" Text="2"/>
                            <TextBlock Text="Cortante Vy (tf)" VerticalAlignment="Center"/>
                            <TextBox x:Name="ShearYTextBox" Text="1"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Materiais" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Placa fy (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlateFyTextBox" Text="250"/>
                            <TextBlock Text="Placa fu (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlateFuTextBox" Text="400"/>
                            <TextBlock Text="Concreto fck (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConcreteFckTextBox" Text="30"/>
                            <TextBlock Text="Chumbador fy (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorFyTextBox" Text="250"/>
                            <TextBlock Text="Chumbador fu (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorFuTextBox" Text="400"/>
                            <TextBlock Text="Coluna fy (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="ColumnFyTextBox" Text="250"/>
                            <TextBlock Text="Coluna fu (MPa)" VerticalAlignment="Center"/>
                            <TextBox x:Name="ColumnFuTextBox" Text="400"/>
                        </UniformGrid>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <GroupBox Header="Placa" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Lx (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlateLengthXTextBox" Text="300"/>
                            <TextBlock Text="Ly (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlateLengthYTextBox" Text="450"/>
                            <TextBlock Text="Espessura (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlateThicknessTextBox" Text="19"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Chumbadores" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Diâmetro (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorDiameterTextBox" Text="19"/>
                            <TextBlock Text="Embutimento (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="EmbedmentLengthTextBox" Text="250"/>
                            <TextBlock Text="Corrosão (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="CorrosionAllowanceTextBox" Text="0"/>
                            <TextBlock Text="Quantidade X" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorsXTextBox" Text="2"/>
                            <TextBlock Text="Quantidade Y" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorsYTextBox" Text="2"/>
                            <TextBlock Text="Borda X (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorEdgeDistanceXTextBox" Text="60"/>
                            <TextBlock Text="Borda Y (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnchorEdgeDistanceYTextBox" Text="70"/>
                            <CheckBox x:Name="HasHookCheckBox" Content="Com gancho" IsChecked="True"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Nervuras" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10">
                            <TextBlock Text="Espessura (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="StiffenerThicknessTextBox" Text="0"/>
                            <TextBlock Text="Altura (mm)" VerticalAlignment="Center"/>
                            <TextBox x:Name="StiffenerHeightTextBox" Text="0"/>
                            <CheckBox x:Name="HasMiddleStiffenerCheckBox"
                                      Content="Nervura intermediária"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Resultado">
                        <StackPanel Margin="10">
                            <TextBlock x:Name="SummaryTextBlock"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="VerificationTextBlock"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Calcular"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Calculate_Click"
                    Background="#0052CC"
                    Foreground="White"
                    BorderBrush="#0052CC"/>
            <Button Content="Fechar"
                    Width="92"
                    Height="34"
                    IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
