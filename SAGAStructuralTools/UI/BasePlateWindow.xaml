<Window x:Class="SAGAStructuralTools.UI.BasePlateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SAGAStructuralTools.UI"
        Title="Dimensionamento de Placa de Base"
        Width="980"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="pt-BR"
        Background="#F8F9FB"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        </Style>
        <Style x:Key="InfoIconStyle" TargetType="Border">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="CornerRadius" Value="6.5"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
        </Style>
        <Style x:Key="VerificationCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding Background, Mode=OneWay}"/>
            <Setter Property="Foreground" Value="{Binding Foreground, Mode=OneWay}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Dimensionamento de Placa de Base"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"/>
            <TextBlock Margin="0,5,0,0"
                       Text="Dados organizados no padrão da planilha"
                       Foreground="#5E6C84"/>
            <Border Margin="0,12,0,0"
                    Padding="8"
                    BorderBrush="#C7D1DB"
                    BorderThickness="1"
                    Background="#FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Configuração"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox Width="240"
                              IsEditable="True"
                              ItemsSource="{Binding SavedConfigurationNames, Mode=OneWay}"
                              SelectedItem="{Binding SelectedConfigurationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding ConfigurationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Selecione uma configuração salva ou digite um novo nome."/>
                    <Button Content="Salvar"
                            Width="82"
                            Height="28"
                            Margin="8,0,0,0"
                            Command="{Binding SaveConfigurationCommand}"
                            ToolTip="Salva todos os dados atuais da ferramenta."/>
                    <Button Content="Excluir"
                            Width="82"
                            Height="28"
                            Margin="6,0,0,0"
                            Command="{Binding DeleteConfigurationCommand}"
                            ToolTip="Exclui a configuração selecionada."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Expander Header="1. Esforços de cálculo" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Nc (tf)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.CompressionForce}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding CompressionForceTf, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Nt (tf)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.TensionForce}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding TensionForceTf, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Mx (tf.m)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.MomentX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding MomentX_TfM, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="My (tf.m)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.MomentY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding MomentY_TfM, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Vx (tf)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ShearX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding ShearX_Tf, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Vy (tf)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ShearY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding ShearY_Tf, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="2. Perfil metálico" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <TextBlock Text="d (mm)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DepthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="bf (mm)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding FlangeWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="tw (mm)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding WebThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="tf (mm)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding FlangeThicknessMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="3. Placa de base e materiais" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="lx (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateLengthX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding PlateLengthXmm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ly (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateLengthY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding PlateLengthYmm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Rotação"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateOrientation}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding PlateOrientationOptions, Mode=OneWay}"
                                      SelectedItem="{Binding PlateOrientationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="tpl (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateThickness}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding PlateThicknessOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedPlateThicknessOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="fy,pl (MPa)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateFy}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding PlateFyMpa, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="fu,pl (MPa)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.PlateFu}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding PlateFuMpa, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="4. Nervuras" IsExpanded="False" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="tn (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.StiffenerThickness}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding PlateThicknessOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedStiffenerThicknessOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="hn (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.StiffenerHeight}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding StiffenerHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Nervura média?"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.MiddleStiffeners}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <CheckBox IsChecked="{Binding HasMiddleStiffener, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>
                    <Expander Header="5. Chumbadores" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="db (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorDiameter}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding AnchorDiameterOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedAnchorOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="lb (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorLength}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding AnchorLengthMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Com gancho?"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorHook}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <CheckBox IsChecked="{Binding HasHook, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ecorrosão (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorCorrosion}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding CorrosionAllowanceMm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="fy,b (MPa)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorFy}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding AnchorFyMpa, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="fu,b (MPa)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorFu}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding AnchorFuMpa, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="nbx"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorsX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding AnchorCountOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedAnchorsX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="nby"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorsY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding AnchorCountOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedAnchorsY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ntot"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.TotalAnchors}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding TotalAnchors, Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     IsTabStop="False"
                                     Focusable="False"
                                     IsHitTestVisible="False"
                                     Background="#EEF0F3"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="a1 (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorEdgeDistanceX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding AnchorEdgeDistanceXmm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="b1 (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.AnchorEdgeDistanceY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding AnchorEdgeDistanceYmm, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>

                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Expander Header="6. Concreto" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="fck (MPa)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ConcreteFck}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <ComboBox ItemsSource="{Binding ConcreteStrengthOptions, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedConcreteStrengthOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="A2/A1"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ConcreteAreaRatio}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding ConcreteAreaRatioA2A1, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="cx (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ConcreteEdgeDistanceX}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding ConcreteEdgeDistanceXmm, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="cy (mm)"/><Border Style="{StaticResource InfoIconStyle}" ToolTip="{x:Static ui:ToolTipTexts.ConcreteEdgeDistanceY}"><TextBlock Text="!" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                            <TextBox Text="{Binding ConcreteEdgeDistanceYmm, UpdateSourceTrigger=PropertyChanged}"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="7. Resultados" IsExpanded="True" Margin="0,0,0,10">
                        <UniformGrid Columns="2" Margin="10" HorizontalAlignment="Left" Width="430">
                            <TextBlock Text="Fty,d (ton)"/>
                            <TextBox Text="{Binding AnchorTensionResult, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="Fv,d (ton)"/>
                            <TextBox Text="{Binding AnchorShearResult, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="Rc,v (ton)"/>
                            <TextBox Text="{Binding AnchorConcreteShearResistance, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="Rc,t (ton)"/>
                            <TextBox Text="{Binding AnchorConcreteTensionResistance, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="Rs,v (ton)"/>
                            <TextBox Text="{Binding AnchorSteelShearResistance, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="Rs,t (ton)"/>
                            <TextBox Text="{Binding AnchorSteelTensionResistance, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="tplmin (mm)"/>
                            <TextBox Text="{Binding MinimumPlateThickness, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                            <TextBlock Text="tnmin (mm)"/>
                            <TextBox Text="{Binding MinimumStiffenerThickness, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="8. Croqui técnico da base" IsExpanded="True" Margin="0,0,0,10">
                        <Border Margin="10"
                                Height="280"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Background="White">
                            <ui:BasePlateSketchControl PlateLengthX="{Binding SketchPlateLengthX, Mode=OneWay}"
                                                       PlateLengthY="{Binding SketchPlateLengthY, Mode=OneWay}"
                                                       ProfileDepth="{Binding SketchProfileDepth, Mode=OneWay}"
                                                       ProfileFlangeWidth="{Binding SketchProfileFlangeWidth, Mode=OneWay}"
                                                       AnchorDiameter="{Binding SketchAnchorDiameter, Mode=OneWay}"
                                                       AnchorEdgeDistanceX="{Binding SketchAnchorEdgeDistanceX, Mode=OneWay}"
                                                       AnchorEdgeDistanceY="{Binding SketchAnchorEdgeDistanceY, Mode=OneWay}"
                                                       PlateThickness="{Binding SketchPlateThickness, Mode=OneWay}"
                                                       StiffenerHeight="{Binding SketchStiffenerHeight, Mode=OneWay}"
                                                       StiffenerThickness="{Binding SketchStiffenerThickness, Mode=OneWay}"
                                                       OrientationDegrees="{Binding PlateOrientationDegreesValue, Mode=OneWay}"
                                                       BoltPoints="{Binding BoltPoints, Mode=OneWay}"/>
                        </Border>
                    </Expander>

                    <Expander Header="9. Solicitações" IsExpanded="True" Margin="0,0,0,10">
                        <StackPanel Margin="10" HorizontalAlignment="Left">
                            <TextBlock Text="Taxa de uso"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="115"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Concreto" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding ConcreteUtilizationResult, Mode=OneWay}"
                                         Grid.Row="0"
                                         Grid.Column="2"
                                         Width="115"
                                         Padding="5,2"
                                         Background="{Binding ConcreteUtilizationBackground, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsTabStop="False"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Aço 1" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SteelUtilization1Result, Mode=OneWay}"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         Width="115"
                                         Padding="5,2"
                                         Background="{Binding SteelUtilization1Background, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsTabStop="False"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Aço 2" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SteelUtilization2Result, Mode=OneWay}"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         Width="115"
                                         Padding="5,2"
                                         Background="{Binding SteelUtilization2Background, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsTabStop="False"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <GroupBox Grid.Row="2" Header="VERIFICAÇÕES" Margin="0,14,0,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10" Margin="0,0,0,8" Background="{Binding OverallStatusBackground, Mode=OneWay}">
                    <TextBlock Text="{Binding OverallStatusText, Mode=OneWay}"
                               Foreground="{Binding OverallStatusForeground, Mode=OneWay}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Verifications, Mode=OneWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="42"
                          CellStyle="{StaticResource VerificationCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Verificação" Binding="{Binding Name, Mode=OneWay}" Width="210"/>
                        <DataGridTemplateColumn Header="Resultado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Icon, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding ResultText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Utilization, Mode=OneWay, StringFormat=Utilização: {0:P1}}" FontSize="11"/>
                                            <TextBlock Text="  "/>
                                            <TextBlock Text="{Binding GoverningCase, Mode=OneWay, StringFormat=Caso governante: {0}}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Criar ligação"
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding CreateConnectionCommand}"
                    IsEnabled="{Binding CanCreateConnection, Mode=OneWay}"
                    ToolTip="{x:Static ui:ToolTipTexts.CreateButton}"/>
            <Button Content="Fechar"
                    Width="92"
                    Height="34"
                    IsCancel="True"
                    Click="Close_Click"
                    ToolTip="{x:Static ui:ToolTipTexts.CloseButton}"/>
        </StackPanel>
    </Grid>
</Window>


