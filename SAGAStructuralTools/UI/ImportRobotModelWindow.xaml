<Window x:Class="SAGAStructuralTools.UI.ImportRobotModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA — Importar Modelo do Robot"
        Width="820" Height="640"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Título -->
            <RowDefinition Height="Auto"/>  <!-- Catálogo -->
            <RowDefinition Height="Auto"/>  <!-- Pasta de logs -->
            <RowDefinition Height="*"/>     <!-- Log + Gaps -->
            <RowDefinition Height="Auto"/>  <!-- Progresso -->
            <RowDefinition Height="Auto"/>  <!-- Botões -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Importar Modelo do Robot → Famílias Gerdau"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Famílias Gerdau (.rfa):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding CatalogPath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True" VerticalAlignment="Center" Padding="4,2" Background="#F5F5F5"/>
            <Button Grid.Column="2" Content="..." Width="34" Height="26" Margin="8,0,0,0"
                    ToolTip="Selecionar diretório" Command="{Binding BrowseCatalogCommand}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pasta de logs:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True" VerticalAlignment="Center" Padding="4,2" Background="#F5F5F5"/>
            <Button Grid.Column="2" Content="..." Width="34" Height="26" Margin="8,0,0,0"
                    ToolTip="Selecionar pasta onde os logs serão salvos" Command="{Binding BrowseLogDirCommand}"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Log de Operações" Margin="0,0,0,10">
                <ListBox ItemsSource="{Binding LogEntries}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="#1E1E1E" Foreground="#D4D4D4"
                         BorderThickness="0" Padding="4"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Visibility="{Binding HasGaps, Converter={StaticResource BoolToVis}}">
                <GroupBox.Header>
                    <TextBlock Text="Perfis sem correspondência — revise antes de incluir no catálogo"/>
                </GroupBox.Header>
                <DataGrid ItemsSource="{Binding Gaps}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="28" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barra" Binding="{Binding BarId}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Papel" Binding="{Binding RoleLabel}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Perfil (Robot)" Binding="{Binding RawDesignation}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Origem da sugestão" Binding="{Binding SourceLabel}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Peso (kg/m)" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding WeightKgPerMeter, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                             IsEnabled="{Binding CanInclude}" Padding="2" BorderThickness="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Incluir" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanInclude}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <ProgressBar Grid.Row="4" Height="6" Margin="0,12,0,12"
                     Value="{Binding Progress}" Maximum="100"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Adicionar ao catálogo e continuar" Width="220"
                    Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                    Command="{Binding ApplyGapsCommand}"/>
            <Button Content="Importar" Width="140"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding ImportCommand}"/>
        </StackPanel>
    </Grid>
</Window>
