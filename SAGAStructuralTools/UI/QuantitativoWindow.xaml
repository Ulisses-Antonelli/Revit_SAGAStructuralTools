<Window x:Class="SAGAStructuralTools.UI.QuantitativoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SAGAStructuralTools.UI.Converters"
        Title="SAGA — Lista de Perfis (Quantitativo)"
        Width="820" MinWidth="640" Height="620" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDouble"/>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CleanInput" TargetType="TextBox">
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="#DFE1E6"/>
            <Setter Property="Background"        Value="White"/>
            <Setter Property="Padding"           Value="8,5,4,5"/>
            <Setter Property="Foreground"        Value="#172B4D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Width"             Value="70"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="#0052CC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#AABDD8"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"> <Setter Property="Background" Value="#0747A6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#344563"/>
            <Setter Property="BorderBrush"     Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F5F7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PvLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#5E6C84"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PvValue" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#0052CC"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Margem de perda (%)" Style="{StaticResource PvLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Style="{StaticResource CleanInput}" Margin="0,0,20,0"
                     Text="{Binding MarginPercent, Converter={StaticResource FlexibleDouble}, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Text="Nome da tabela no Revit" Style="{StaticResource PvLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Style="{StaticResource CleanInput}" Width="240"
                     Text="{Binding ScheduleName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#00875A" FontSize="12" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="OnClose"/>
                <Button Content="Exportar CSV" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}"/>
                <Button Content="Criar/Atualizar Tabela no Revit" Style="{StaticResource BtnPrimary}" Command="{Binding CreateScheduleCommand}"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12" DockPanel.Dock="Bottom">
            <StackPanel>
                <TextBlock Text="TOTAL" FontWeight="SemiBold" FontSize="12" Foreground="#344563" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Comprimento" Style="{StaticResource PvLabel}"/>
                        <TextBlock Text="{Binding TotalLengthText}" Style="{StaticResource PvValue}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Peso" Style="{StaticResource PvLabel}"/>
                        <TextBlock Text="{Binding TotalWeightText}" Style="{StaticResource PvValue}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Peso + margem" Style="{StaticResource PvLabel}"/>
                        <TextBlock Text="{Binding TotalWeightMarginText}" Style="{StaticResource PvValue}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Padding="0">
            <DockPanel>
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Warnings}" Margin="16,0,16,8" MaxHeight="90">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B25000" FontSize="12" Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0" Margin="0,8,0,0"
                          RowHeaderWidth="0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="1.4*"/>
                        <DataGridTextColumn Header="Qtd." Binding="{Binding ElementCount}" Width="0.6*"/>
                        <DataGridTextColumn Header="Comprimento (m)" Binding="{Binding TotalLengthM, StringFormat=F1}" Width="1.2*"/>
                        <DataGridTextColumn Header="Peso Unit. (kg/m)" Binding="{Binding UnitWeightKgM, StringFormat=F2}" Width="1.2*"/>
                        <DataGridTextColumn Header="Peso (kg)" Binding="{Binding TotalWeightKg, StringFormat=F1}" Width="1.1*"/>
                        <DataGridTextColumn Header="Peso + margem (kg)" Binding="{Binding TotalWeightWithMarginKg, StringFormat=F1}" Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
