<Window x:Class="SAGAStructuralTools.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGA Structural Tools — Conversor IFC → Gerdau"
        Width="660" Height="540"
        MinWidth="500" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Background"      Value="#0078D4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Título -->
            <RowDefinition Height="Auto"/>  <!-- Caminho das famílias -->
            <RowDefinition Height="Auto"/>  <!-- Pasta de logs -->
            <RowDefinition Height="*"/>     <!-- Log -->
            <RowDefinition Height="Auto"/>  <!-- Barra de progresso -->
            <RowDefinition Height="Auto"/>  <!-- Botão converter -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Conversor IFC → Famílias Gerdau"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Seleção do diretório de famílias Gerdau -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Famílias Gerdau (.rfa):"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox Grid.Column="1"
                     Text="{Binding CatalogPath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Padding="4,2"
                     Background="#F5F5F5"/>

            <Button Grid.Column="2"
                    Content="..."
                    Width="34" Height="26"
                    Margin="8,0,0,0"
                    ToolTip="Selecionar diretório"
                    Command="{Binding BrowseCatalogCommand}"/>
        </Grid>

        <!-- Pasta de salvamento dos logs -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Pasta de logs:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox Grid.Column="1"
                     Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     VerticalAlignment="Center"
                     Padding="4,2"
                     Background="#F5F5F5"/>

            <Button Grid.Column="2"
                    Content="..."
                    Width="34" Height="26"
                    Margin="8,0,0,0"
                    ToolTip="Selecionar pasta onde os logs serão salvos"
                    Command="{Binding BrowseLogDirCommand}"/>
        </Grid>

        <!-- Área de log em tempo real -->
        <GroupBox Grid.Row="3" Header="Log de Operações" Margin="0,0,0,12">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding LogEntries}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     Background="#1E1E1E" Foreground="#D4D4D4"
                     BorderThickness="0"
                     Padding="4"/>
        </GroupBox>

        <!-- Barra de progresso (visível somente durante a conversão) -->
        <ProgressBar Grid.Row="4"
                     Height="6"
                     Margin="0,0,0,12"
                     Value="{Binding Progress}"
                     Maximum="100"
                     Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}"/>

        <!-- Botão principal -->
        <Button Grid.Row="5"
                Content="Converter IFC → Gerdau"
                Style="{StaticResource ActionButton}"
                Command="{Binding ConvertCommand}"/>
    </Grid>
</Window>
