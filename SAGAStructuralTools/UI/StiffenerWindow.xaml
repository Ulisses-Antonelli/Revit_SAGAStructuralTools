<Window x:Class="SAGAStructuralTools.UI.StiffenerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SAGAStructuralTools.UI.Converters"
        Title="SAGA — Gerar Nervura em Perfil W"
        Width="440" MinWidth="400" Height="560" MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <converters:FlexibleDoubleConverter x:Key="FlexibleDouble"/>

        <!-- ── Identidade visual compartilhada (mesmos estilos das outras ferramentas) ── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CleanInput" TargetType="TextBox">
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="#DFE1E6"/>
            <Setter Property="Background"        Value="White"/>
            <Setter Property="Padding"           Value="8,5,4,5"/>
            <Setter Property="Foreground"        Value="#172B4D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="13"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="#0052CC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#AABDD8"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"> <Setter Property="Background" Value="#0747A6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#344563"/>
            <Setter Property="BorderBrush"     Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F5F7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PvLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#5E6C84"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PvValue" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="#0052CC"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"               Value="#344563"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="{Binding CreateActionText}" Style="{StaticResource BtnPrimary}" Command="{Binding CreateCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Seleção da viga -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="VIGA OU PILAR W" FontWeight="SemiBold" FontSize="12" Foreground="#344563" Margin="0,0,0,10"/>
                        <Button Content="Selecionar peça e ponto" Style="{StaticResource BtnSecondary}"
                                HorizontalAlignment="Left" Command="{Binding PickBeamCommand}"/>
                        <TextBlock Text="{Binding BeamName}" Margin="0,8,0,0" FontSize="12" Foreground="#5E6C84"/>
                    </StackPanel>
                </Border>

                <!-- Referência de alinhamento (opcional) -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ALINHAMENTO (OPCIONAL)" FontWeight="SemiBold" FontSize="12" Foreground="#344563" Margin="0,0,0,4"/>
                        <TextBlock Text="Clique na face de um pilar (ou numa linha) para a nervura nascer rente a ela, em vez de centrada no ponto clicado na viga."
                                   TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Selecionar face de referência" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Left" Command="{Binding SelectAlignmentReferenceCommand}"/>
                            <Button Content="Limpar" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"
                                    Command="{Binding ClearAlignmentReferenceCommand}"/>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#5E6C84">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Sem referência — chapa centrada no ponto clicado."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAlignReference}" Value="True">
                                            <Setter Property="Text" Value="{Binding AlignReferenceName, StringFormat='Alinhado à face de: {0}'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <CheckBox Content="Inverter lado (se a chapa nascer para o lado errado)" Margin="0,10,0,0"
                                  IsChecked="{Binding FlipAlignmentSide}" IsEnabled="{Binding HasAlignReference}"/>
                    </StackPanel>
                </Border>

                <!-- Configuração -->
                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CONFIGURAÇÃO" FontWeight="SemiBold" FontSize="12" Foreground="#344563" Margin="0,0,0,10"/>

                        <TextBlock Text="Espessura da chapa (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource CleanInput}" Margin="0,0,0,10"
                                 Text="{Binding PlateThicknessMm, Converter={StaticResource FlexibleDouble}, UpdateSourceTrigger=LostFocus}"/>

                        <TextBlock Text="Chanfro (mm) — 0 = calcular automaticamente" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource CleanInput}" Margin="0,0,0,10"
                                 Text="{Binding ChamferOverrideMm, Converter={StaticResource FlexibleDouble}, UpdateSourceTrigger=LostFocus}"/>

                        <CheckBox Content="Ambos os lados da alma (espelhado)" IsChecked="{Binding Symmetric}"/>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" FontWeight="SemiBold" FontSize="12" Foreground="#344563" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chanfro aplicado" Style="{StaticResource PvLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PreviewChamfer}" Style="{StaticResource PvValue}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chapas a criar" Style="{StaticResource PvLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PreviewPlateCount}" Style="{StaticResource PvValue}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B25000" FontSize="12" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
