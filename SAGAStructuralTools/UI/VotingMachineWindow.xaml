<Window x:Class="SAGAStructuralTools.UI.VotingMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Urna Eletrônica — Simulação"
        Width="820" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#25282C"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#17191C"/>
            <Setter Property="BorderBrush" Value="#050607"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBody" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="3" Opacity="0.65"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBody" Property="Background" Value="#2C3035"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBody" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#101214"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBody" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="3" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBody" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border CornerRadius="14" BorderBrush="#777A7D" BorderThickness="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F1F0EA" Offset="0"/>
                    <GradientStop Color="#CBCBC5" Offset="0.56"/>
                    <GradientStop Color="#A9AAA6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="8" BlurRadius="16" Opacity="0.65"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Visor -->
                <Border Grid.Column="0" Background="#313438" BorderBrush="#777" BorderThickness="4"
                        CornerRadius="5" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="JUSTIÇA ELEITORAL" Foreground="White" FontSize="15"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <Border Grid.Row="1" Background="#EDF0E8" BorderBrush="#111" BorderThickness="2" Padding="20,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="SEU VOTO PARA" FontSize="15" FontWeight="SemiBold" Foreground="#151515"/>
                                <TextBlock Grid.Row="1" Text="PRESIDENTE" FontSize="20" FontWeight="Bold"
                                           Foreground="#111" Margin="0,5,0,8"/>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Número:" FontSize="15" Foreground="#222"/>
                                    <TextBlock x:Name="NumberDisplay" Text="__" FontFamily="Consolas"
                                               FontSize="55" FontWeight="Bold"
                                               Foreground="#111" Margin="0,-3,0,3"/>
                                    <StackPanel x:Name="CandidatePanel" Visibility="Collapsed">
                                        <TextBlock Text="Nome: LULA" FontSize="19" FontWeight="Bold" Foreground="#161616"/>
                                        <TextBlock Text="Partido: PT" FontSize="16" Foreground="#333" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="FeedbackText" Grid.Row="3" Text="Digite dois números e pressione CONFIRMA"
                                           Foreground="#343434" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="SIMULAÇÃO — BRINCADEIRA" Foreground="#D9D9D9"
                                   FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Teclado -->
                <Border Grid.Column="2" Background="#3B3E42" BorderBrush="#737578" BorderThickness="3"
                        CornerRadius="7" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="TECLADO" Foreground="#E7E7E7" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <UniformGrid Grid.Row="1" Rows="4" Columns="3" HorizontalAlignment="Center">
                            <Button Style="{StaticResource KeyButton}" Content="1" Tag="1" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="2" Tag="2" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="3" Tag="3" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="4" Tag="4" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="5" Tag="5" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="6" Tag="6" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="7" Tag="7" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="8" Tag="8" Click="OnNumberClick"/>
                            <Button Style="{StaticResource KeyButton}" Content="9" Tag="9" Click="OnNumberClick"/>
                            <Border/>
                            <Button Style="{StaticResource KeyButton}" Content="0" Tag="0" Click="OnNumberClick"/>
                            <Border/>
                        </UniformGrid>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ActionButton}" Content="BRANCO"
                                    Background="#F2F2EF" Click="OnWhiteClick"/>
                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="CORRIGE"
                                    Background="#F28A3B" Click="OnCorrectClick"/>
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="CONFIRMA"
                                    Background="#66B86B" Click="OnConfirmClick"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
