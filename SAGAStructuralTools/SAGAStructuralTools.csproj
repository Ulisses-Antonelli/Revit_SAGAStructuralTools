<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SAGAStructuralTools</AssemblyName>
    <RootNamespace>SAGAStructuralTools</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API: compile-time only, NOT copied to output (Private=false) -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Required for FolderBrowserDialog -->
    <Reference Include="System.Windows.Forms" />
    <!-- Required for System.Drawing.Bitmap (icon loading) -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content: copiado para o output e depois para o deploy folder junto com a DLL -->
    <Content Include="Resources\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Post-build: copia a DLL e o .addin para a pasta de addins do Revit 2023.
    Revit lê automaticamente qualquer .addin que estiver em:
    C:\ProgramData\Autodesk\Revit\Addins\2023\
  -->
  <Target Name="DeployToRevit" AfterTargets="Build">
    <PropertyGroup>
      <DeployDir>C:\ProgramData\Autodesk\Revit\Addins\2023</DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)\Resources\Icons"
             Condition="!Exists('$(DeployDir)\Resources\Icons')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(DeployDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\SAGAStructuralTools.addin"
          DestinationFolder="$(DeployDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <IconFiles Include="$(MSBuildProjectDirectory)\Resources\Icons\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(IconFiles)"
          DestinationFolder="$(DeployDir)\Resources\Icons"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
