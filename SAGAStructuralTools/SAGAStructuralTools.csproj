<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <AssemblyName>SAGAStructuralTools</AssemblyName>
    <RootNamespace>SAGAStructuralTools</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms Condition="'$(TargetFramework)'=='net8.0-windows'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Revit 2023 / .NET 4.8 -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Revit 2026 / .NET 8 -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Users\Ulisses\Desktop\dll_REVIT_2026\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Users\Ulisses\Desktop\dll_REVIT_2026\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Content: copiado para o output e depois para o deploy folder junto com a DLL -->
    <Content Include="Resources\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Post-build: copia a DLL e o .addin para a pasta de addins do Revit 2023.
    Revit lê automaticamente qualquer .addin que estiver em:
    C:\ProgramData\Autodesk\Revit\Addins\2023\
  -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <DeployDir Condition="'$(TargetFramework)'=='net48'">C:\ProgramData\Autodesk\Revit\Addins\2023</DeployDir>
      <DeployDir Condition="'$(TargetFramework)'=='net8.0-windows'">C:\ProgramData\Autodesk\Revit\Addins\2026</DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)\Resources\Icons"
             Condition="!Exists('$(DeployDir)\Resources\Icons')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(DeployDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\SAGAStructuralTools.addin"
          DestinationFolder="$(DeployDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <IconFiles Include="$(MSBuildProjectDirectory)\Resources\Icons\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(IconFiles)"
          DestinationFolder="$(DeployDir)\Resources\Icons"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
