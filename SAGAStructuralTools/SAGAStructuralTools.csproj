<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <AssemblyName>SAGAStructuralTools</AssemblyName>
    <RootNamespace>SAGAStructuralTools</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms Condition="'$(TargetFramework)'=='net8.0-windows'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- O add-in é uma class library carregada dinamicamente pelo Revit. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DeployToRevit Condition="'$(DeployToRevit)'==''">false</DeployToRevit>
    <SagaArtifactsRoot>$(MSBuildProjectDirectory)\..\artifacts</SagaArtifactsRoot>
    <SagaPayloadTool>$(MSBuildProjectDirectory)\..\tools\Sync-RevitPayload.ps1</SagaPayloadTool>
    <SagaDeployTool>$(MSBuildProjectDirectory)\..\tools\Deploy-RevitPayload.ps1</SagaDeployTool>
    <SagaAddinManifest Condition="'$(TargetFramework)'=='net48'">$(MSBuildProjectDirectory)\SAGAStructuralTools.addin</SagaAddinManifest>
    <SagaAddinManifest Condition="'$(TargetFramework)'=='net8.0-windows'">$(MSBuildProjectDirectory)\SAGAStructuralTools.Revit2026.addin</SagaAddinManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAGAStructuralTools.Strap.Domain\SAGAStructuralTools.Strap.Domain.csproj" />
    <ProjectReference Include="..\SAGAStructuralTools.Strap.Application\SAGAStructuralTools.Strap.Application.csproj" />
    <ProjectReference Include="..\SAGAStructuralTools.Strap.Readers\SAGAStructuralTools.Strap.Readers.csproj" />
  </ItemGroup>

  <Target Name="CaptureSagaRuntimeAssets"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(TargetFramework)'=='net8.0-windows'">
    <ItemGroup>
      <SagaCapturedRuntimeAsset Include="@(RuntimeTargetsCopyLocalItems)" />
    </ItemGroup>
  </Target>

  <!-- O payload vem das referências privadas resolvidas para o target atual. -->
  <Target Name="StageRevitPayload"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="ResolveReferences"
          Condition="'$(TargetFramework)'=='net48' or '$(TargetFramework)'=='net8.0-windows'">
    <PropertyGroup>
      <SagaRevitVersion Condition="'$(TargetFramework)'=='net48'">2023</SagaRevitVersion>
      <SagaRevitVersion Condition="'$(TargetFramework)'=='net8.0-windows'">2026</SagaRevitVersion>
      <SagaStagingDirectory>$(SagaArtifactsRoot)\Revit$(SagaRevitVersion)</SagaStagingDirectory>
      <SagaPayloadInput>$(IntermediateOutputPath)SAGAStructuralTools.payload-input.txt</SagaPayloadInput>
      <SagaProjectReferenceInput>$(IntermediateOutputPath)SAGAStructuralTools.project-references.txt</SagaProjectReferenceInput>
    </PropertyGroup>
    <ItemGroup>
      <SagaPayloadFile Include="$(TargetPath)">
        <SagaTargetPath>SAGAStructuralTools\$(TargetFileName)</SagaTargetPath>
        <SagaKind>MainAssembly</SagaKind>
      </SagaPayloadFile>
      <SagaPayloadFile Include="$(TargetDir)$(TargetName).deps.json"
                       Condition="'$(TargetFramework)'=='net8.0-windows' and Exists('$(TargetDir)$(TargetName).deps.json')">
        <SagaTargetPath>SAGAStructuralTools\$(TargetName).deps.json</SagaTargetPath>
        <SagaKind>DependencyContext</SagaKind>
      </SagaPayloadFile>
      <SagaPayloadFile Include="$(TargetDir)$(TargetName).pdb"
                       Condition="Exists('$(TargetDir)$(TargetName).pdb')">
        <SagaTargetPath>SAGAStructuralTools\$(TargetName).pdb</SagaTargetPath>
        <SagaKind>OptionalSymbols</SagaKind>
      </SagaPayloadFile>
      <SagaPayloadFile Include="@(ReferenceCopyLocalPaths)">
        <SagaTargetPath>SAGAStructuralTools\%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</SagaTargetPath>
        <SagaKind>ResolvedReference</SagaKind>
      </SagaPayloadFile>
      <!--
        RuntimeCopyLocalItems conserva assets runtime resolvidos que podem ser
        suprimidos de ReferenceCopyLocalPaths pelo conflito com o shared
        framework (caso de System.Text.Encoding.CodePages no .NET 8).
      -->
      <SagaPayloadFile Include="@(RuntimeCopyLocalItems)"
                       Condition="'$(TargetFramework)'=='net8.0-windows'">
        <SagaTargetPath>SAGAStructuralTools\%(RuntimeCopyLocalItems.DestinationSubPath)</SagaTargetPath>
        <SagaKind>ResolvedRuntimeAsset</SagaKind>
      </SagaPayloadFile>
      <SagaPayloadFile Include="@(SagaCapturedRuntimeAsset)"
                       Condition="'$(TargetFramework)'=='net8.0-windows'">
        <SagaTargetPath>SAGAStructuralTools\%(SagaCapturedRuntimeAsset.Filename)%(SagaCapturedRuntimeAsset.Extension)</SagaTargetPath>
        <SagaKind>ResolvedRuntimeTargetAsset</SagaKind>
      </SagaPayloadFile>
      <SagaPayloadFile Include="$(SagaAddinManifest)">
        <SagaTargetPath>SAGAStructuralTools.addin</SagaTargetPath>
        <SagaKind>AddinManifest</SagaKind>
      </SagaPayloadFile>
      <SagaIconFile Include="$(MSBuildProjectDirectory)\Resources\Icons\*.png">
        <SagaIconTargetPath>SAGAStructuralTools\Resources\Icons\%(Filename)%(Extension)</SagaIconTargetPath>
      </SagaIconFile>
      <SagaPayloadFile Include="@(SagaIconFile)">
        <SagaTargetPath>%(SagaIconFile.SagaIconTargetPath)</SagaTargetPath>
        <SagaKind>Resource</SagaKind>
      </SagaPayloadFile>
      <SagaExpectedProjectReference Include="@(ProjectReference)">
        <SagaAssemblyName>%(Filename).dll</SagaAssemblyName>
      </SagaExpectedProjectReference>
    </ItemGroup>
    <WriteLinesToFile File="$(SagaPayloadInput)"
                      Lines="@(SagaPayloadFile->'%(FullPath)|%(SagaTargetPath)|%(SagaKind)')"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(SagaProjectReferenceInput)"
                      Lines="@(SagaExpectedProjectReference->'%(SagaAssemblyName)')"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SagaPayloadTool)&quot; -InputManifest &quot;$(SagaPayloadInput)&quot; -ProjectReferenceManifest &quot;$(SagaProjectReferenceInput)&quot; -StagingDirectory &quot;$(SagaStagingDirectory)&quot; -ArtifactsRoot &quot;$(SagaArtifactsRoot)&quot; -TargetFramework &quot;$(TargetFramework)&quot; -RevitVersion &quot;$(SagaRevitVersion)&quot;" />
  </Target>

  <Target Name="DeployToRevit"
          AfterTargets="StageRevitPayload"
          DependsOnTargets="StageRevitPayload"
          Condition="('$(TargetFramework)'=='net48' or '$(TargetFramework)'=='net8.0-windows') and '$(DeployToRevit)'=='true'">
    <PropertyGroup>
      <SagaRevitVersion Condition="'$(TargetFramework)'=='net48'">2023</SagaRevitVersion>
      <SagaRevitVersion Condition="'$(TargetFramework)'=='net8.0-windows'">2026</SagaRevitVersion>
      <SagaStagingDirectory>$(SagaArtifactsRoot)\Revit$(SagaRevitVersion)</SagaStagingDirectory>
      <SagaDeployDirectory>C:\ProgramData\Autodesk\Revit\Addins\$(SagaRevitVersion)</SagaDeployDirectory>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(SagaDeployTool)&quot; -StagingDirectory &quot;$(SagaStagingDirectory)&quot; -DestinationDirectory &quot;$(SagaDeployDirectory)&quot; -ExpectedTargetFramework &quot;$(TargetFramework)&quot; -ExpectedRevitVersion &quot;$(SagaRevitVersion)&quot;" />
  </Target>

</Project>
